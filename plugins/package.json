{
  "name": "aicode-plugin-build",
  "private": true,
  "description": "AiCode New 插件源码构建工具链",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:plugins": "node build.mjs",
    "build:sdk": "tsc -p sdk/tsconfig.json",
    "typecheck:sdk": "tsc --noEmit -p sdk/test/tsconfig.json",
    "watch:plugins": "node build.mjs --watch",
    "typecheck:plugins": "tsc --noEmit -p tsconfig.json",
    "check:host-methods": "node ../scripts/check-host-methods.mjs",
    "check:page-bridge": "node ../scripts/check-page-bridge.mjs",
    "check:manifests": "node schema/check-manifests.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vue": "3.5.45"
  }
}
